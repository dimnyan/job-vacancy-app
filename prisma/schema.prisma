// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model m_users {
  user_id      Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  password     String
  phone_number String
  role_id      Int
  created_at   DateTime @default(now())
}

model m_applicants {
  applicant_id  Int      @id @default(autoincrement())
  user_id       Int
  fullname      String
  field_of_work String
  created_at    DateTime @default(now())
}

model m_recruiters {
  recruiter_id Int      @id @default(autoincrement())
  user_id      Int
  fullname     String
  company_id   Int
  created_at   DateTime @default(now())
}

model m_roles {
  role_id   Int    @id
  role_name String
}

model m_companies {
  company_id          Int      @id @default(autoincrement())
  company_name        String
  company_description String
  updated_at          DateTime @default(now())
  created_at          DateTime @default(now())
}
